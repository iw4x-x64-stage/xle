#pragma once

// The numeric version format is AAAAABBBBBCCCCCDDDE where:
//
// AAAAA - major version number
// BBBBB - minor version number
// CCCCC - bugfix version number
// DDD   - alpha / beta (DDD + 500) version number
// E     - final (0) / snapshot (1)
//
// When DDDE is not 0, 1 is subtracted from AAAAABBBBBCCCCC. For example:
//
// Version      AAAAABBBBBCCCCCDDDE
//
// 0.1.0        0000000001000000000
// 0.1.2        0000000001000020000
// 1.2.3        0000100002000030000
// 2.2.0-a.1    0000200001999990010
// 3.0.0-b.2    0000299999999995020
// 2.2.0-a.1.z  0000200001999990011
//
#define LIBXLE_VERSION       $libxle.version.project_number$ULL
#define LIBXLE_VERSION_STR   "$libxle.version.project$"
#define LIBXLE_VERSION_ID    "$libxle.version.project_id$"
#define LIBXLE_VERSION_FULL  "$libxle.version$"

#define LIBXLE_VERSION_MAJOR $libxle.version.major$
#define LIBXLE_VERSION_MINOR $libxle.version.minor$
#define LIBXLE_VERSION_PATCH $libxle.version.patch$

#define LIBXLE_PRE_RELEASE   $libxle.version.pre_release$

#define LIBXLE_SNAPSHOT_SN   $libxle.version.snapshot_sn$ULL
#define LIBXLE_SNAPSHOT_ID   "$libxle.version.snapshot_id$"
