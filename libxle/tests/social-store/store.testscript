# The tests of the social store. They are included for each store (see
# testscript).

: follow
:
$* <<EOI >>EOO
follow 1 2 100 3
follow 1 2 200 3
find 1 2
find 2 1
follow 1 3 300 3
follow 1 4 400 3
follow 1 5 500 3
follow 2 5 600 1
EOI
added
existing
2 favorite=false following=false added=100
none
added
added
full
added
EOO

: unfollow
:
$* <<EOI >>EOO
follow 1 2 100 10
unfollow 1 2
unfollow 1 2
find 1 2
follow 1 2 200 10
find 1 2
EOI
added
true
false
none
added
2 favorite=false following=false added=200
EOO

: following
: Test that the followed users following the owner back are marked
:
$* <<EOI >>EOO
follow 1 2 100 10
follow 1 3 100 10
follow 3 1 200 10
find 1 2
find 1 3
find 3 1
EOI
added
added
added
2 favorite=false following=false added=100
3 favorite=false following=true added=100
1 favorite=false following=true added=200
EOO

: favorite
:
$* <<EOI >>EOO
follow 1 2 100 10
favorite 1 2 true
find 1 2
favorite 1 2 false
find 1 2
favorite 1 3 true
EOI
added
true
2 favorite=true following=false added=100
true
2 favorite=false following=false added=100
false
EOO

: people
:
{{
  i = $~/input

  +cat <<EOI >=$i
  follow 1 4 300 10
  follow 1 3 100 10
  follow 1 2 300 10
  follow 1 5 200 10
  follow 3 1 400 10
  follow 5 1 400 10
  favorite 1 2 true
  favorite 1 3 true
  follow 9 1 500 10
  EOI

  : all
  :
  cat $i - <<EOI | $* >>EOO
  people 1 All 0 100
  EOI
  added
  added
  added
  added
  added
  added
  true
  true
  added
  total 4
  3 favorite=true following=true added=100
  5 favorite=false following=true added=200
  2 favorite=true following=false added=300
  4 favorite=false following=false added=300
  EOO

  : favorite
  :
  cat $i - <<EOI | $* >>~%EOO%
  people 1 favorite 0 100
  EOI
  %(added|true)%{9}
  total 2
  3 favorite=true following=true added=100
  2 favorite=true following=false added=300
  EOO

  : friends
  :
  cat $i - <<EOI | $* >>~%EOO%
  people 1 LegacyXboxLiveFriends 0 100
  EOI
  %(added|true)%{9}
  total 2
  3 favorite=true following=true added=100
  5 favorite=false following=true added=200
  EOO

  : range
  :
  cat $i - <<EOI | $* >>~%EOO%
  people 1 All 1 2
  people 1 All 3 2
  people 1 All 4 2
  people 1 All 0 0
  people 2 All 0 10
  EOI
  %(added|true)%{9}
  total 4
  5 favorite=false following=true added=200
  2 favorite=true following=false added=300
  total 4
  4 favorite=false following=false added=300
  total 4
  total 4
  total 0
  EOO
}}

: view-invalid
:
$* <'people 1 Followers 0 10' 2>"error: invalid relationship view 'Followers'" != 0
