: tls
: Test the TLS certificate and key failures
:
{{
  : certificate
  :
  $* --tls-certificate c.pem --tls-key k.pem 2>>~/EOE/ != 0
  /error: unable to load TLS certificate c.pem: .+/
  EOE

  : key
  :
  $* --tls-certificate $src_base/cert.pem --tls-key k.pem 2>>~/EOE/ != 0
  /error: unable to load TLS key k.pem: .+/
  EOE
}}
